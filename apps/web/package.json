{
  "name": "@coinposh/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=e2e --trace off",
    "perf": "playwright test -c e2e/playwright.config.ts --project=perf --trace off",
    "lighthouse": "playwright test -c e2e/playwright.config.ts --project=perf --trace off lighthouse.perf.ts",
    "bundle:check": "node e2e/bundle-size.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "poster:capture": "node scripts/capture-poster.ts"
  },
  "dependencies": {
    "@coinposh/economy": "workspace:*",
    "@coinposh/shared": "workspace:*",
    "@coinposh/sim": "workspace:*",
    "i18next": "26.5.7",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "lighthouse": "13.6.0",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
